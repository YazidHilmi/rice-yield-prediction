# Database SQLite. Baris ini juga boleh dihapus agar backend memakai nilai default.
DB_PATH=./data/app.db

# Google Cloud / Earth Engine project ID.
GEE_PROJECT_ID=your-google-cloud-project-id

# Untuk setup lokal, isi dengan path file service account JSON.
# Contoh Windows: C:/path/to/service-account.json
# Contoh Linux/macOS: /path/to/service-account.json
GEE_SERVICE_ACCOUNT_JSON=C:/path/to/service-account.json

# Alternatif untuk deployment: isi dengan JSON service account lengkap dalam satu baris.
# Gunakan salah satu dari GEE_SERVICE_ACCOUNT_JSON atau GEE_SERVICE_ACCOUNT_JSON_CONTENT.
GEE_SERVICE_ACCOUNT_JSON_CONTENT=

# Token akses TabPFN.
TABPFN_TOKEN=your-tabpfn-token
